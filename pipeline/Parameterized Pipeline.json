{
	"name": "Parameterized Pipeline",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('Select * from ' , pipeline().parameters.SourceTableName)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "AzureSqlTable10",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DelimitedText7",
						"type": "DatasetReference",
						"parameters": {
							"FolderPath": {
								"value": "@pipeline().parameters.SinkFolderPath",
								"type": "Expression"
							},
							"FileName": {
								"value": "@concat(split(pipeline().parameters.SourceTableName, '.')[1], '_', formatDateTime(utcNow(), 'yyyyMMdd_HHmmss'), '.', pipeline().parameters.FileFormat)",
								"type": "Expression"
							}
						}
					}
				]
			}
		],
		"parameters": {
			"SourceTableName": {
				"type": "string",
				"defaultValue": "Sales.Customers"
			},
			"SinkFolderPath": {
				"type": "string",
				"defaultValue": "landing/sales/customers/"
			},
			"FileFormat": {
				"type": "string",
				"defaultValue": "csv"
			}
		},
		"annotations": []
	}
}