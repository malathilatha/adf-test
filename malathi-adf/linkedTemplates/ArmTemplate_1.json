					"p_source_folder_path": {
						"type": "string"
					},
					"p_source_file_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-06-21T09:50:46Z"
			},
			"dependsOn": []
		},
