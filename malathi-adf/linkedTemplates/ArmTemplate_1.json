{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "malathi-adf"
		},
		"trig_file_b_properties_pipeline1_parameters_p_source_folder_path": {
			"type": "string",
			"defaultValue": "source_b"
		},
		"trig_file_b_properties_pipeline1_parameters_p_source_file_name": {
			"type": "string",
			"defaultValue": "source_b.csv"
		},
		"trig_file_c_properties_pipeline1_parameters_p_source_folder_path": {
			"type": "string",
			"defaultValue": "source_c"
		},
		"trig_file_c_properties_pipeline1_parameters_p_source_file_name": {
			"type": "string",
			"defaultValue": "source_c.csv"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/trig_file_b')]",
			"type": "Microsoft.DataFactory/factories/triggers",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"runtimeState": "Started",
				"pipelines": [
					{
						"pipelineReference": {
							"referenceName": "pipeline1",
							"type": "PipelineReference"
						},
						"parameters": {
							"p_source_folder_path": "[parameters('trig_file_b_properties_pipeline1_parameters_p_source_folder_path')]",
							"p_source_file_name": "[parameters('trig_file_b_properties_pipeline1_parameters_p_source_file_name')]"
						}
					}
				],
				"type": "ScheduleTrigger",
				"typeProperties": {
					"recurrence": {
						"frequency": "Minute",
						"interval": 60,
						"startTime": "2026-06-27T13:24:00",
						"timeZone": "India Standard Time"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/trig_file_c')]",
			"type": "Microsoft.DataFactory/factories/triggers",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"runtimeState": "Started",
				"pipelines": [
					{
						"pipelineReference": {
							"referenceName": "pipeline1",
							"type": "PipelineReference"
						},
						"parameters": {
							"p_source_folder_path": "[parameters('trig_file_c_properties_pipeline1_parameters_p_source_folder_path')]",
							"p_source_file_name": "[parameters('trig_file_c_properties_pipeline1_parameters_p_source_file_name')]"
						}
					}
				],
				"type": "ScheduleTrigger",
				"typeProperties": {
					"recurrence": {
						"frequency": "Minute",
						"interval": 45,
						"startTime": "2026-06-27T13:28:00",
						"timeZone": "India Standard Time"
					}
				}
			},
			"dependsOn": []
		}
	]
}